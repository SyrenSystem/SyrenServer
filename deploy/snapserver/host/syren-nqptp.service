[Unit]
Description=SyrenSystem AirPlay 2 timing helper (nqptp, multi client)
Documentation=https://github.com/mikebrady/nqptp
Wants=network-online.target
After=network-online.target systemd-tmpfiles-setup.service

[Service]
ExecStart=/usr/local/libexec/syrensystem/nqptp
User=syren-nqptp
Group=syren-nqptp
# nqptp writes its shared memory here, in a directory the audio container can only read.
BindPaths=/run/syren-airplay:/dev/shm
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# nqptp sets SCHED_FIFO 5 on itself and needs this limit for it.
LimitRTPRIO=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RemoveIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Netlink lets getifaddrs find the MAC address that nqptp turns into its clock ID.
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
