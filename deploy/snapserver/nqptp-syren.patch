+// Only the names the SyrenSystem supervisor uses may make a record, so a stray local sender cannot stop nqptp or use up its records.
+static int syren_client_name_allowed(const char *name) {
+  char allowed[32];
+  int slot;
+  for (slot = 0; slot < MAX_CLIENTS; slot++) {
+    snprintf(allowed, sizeof(allowed), "/syren-airplay-%d", slot);
+    if (strcmp(name, allowed) == 0)
+      return 1;
+  }
+  return 0;
+}
