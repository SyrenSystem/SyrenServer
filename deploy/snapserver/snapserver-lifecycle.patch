+void PcmStream::removeListener(PcmStream::Listener* listener)
+{
+    std::lock_guard<std::mutex> listener_lock(listener_mutex_);
+    pcmListeners_.erase(std::remove_if(pcmListeners_.begin(), pcmListeners_.end(), [listener](const auto& reference)
+    {
+        auto owner = reference.lock();
+        return !owner || owner.get() == listener;
+    }), pcmListeners_.end());
+}
+
+std::vector<PcmStream::ListenerReference> PcmStream::getListeners()
+{
+    std::lock_guard<std::mutex> listener_lock(listener_mutex_);
+    std::vector<ListenerReference> listeners{{primary_listener_, nullptr}};
+    for (const auto& reference : pcmListeners_)
+    {
+        if (auto owner = reference.lock())
+            listeners.push_back({owner.get(), std::move(owner)});
+    }
+    return listeners;
 }
 
 
