[Unit]
Description=SyrenSystem server stack
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__SERVER_DIRECTORY__
# Stop keeps the containers for the rollback helper; start recreates them from the current images.
ExecStart=/usr/bin/podman-compose -f __COMPOSE_FILE__ __PROFILE_COMPOSE__ up -d --no-build --force-recreate
ExecStop=/usr/bin/podman-compose -f __COMPOSE_FILE__ __PROFILE_COMPOSE__ stop
Restart=on-failure
# Lets Snapserver and librespot in the audio container run at real time priority.
LimitRTPRIO=95
RestartSec=3
TimeoutStartSec=0
TimeoutStopSec=45

[Install]
WantedBy=default.target
