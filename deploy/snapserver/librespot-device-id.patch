+fn device_id(name: &str, configured_id: Option<&str>) -> Result<String, &'static str> {
+    match configured_id {
+        Some(identifier) if identifier.len() == 40
+            && identifier.bytes().all(|character| character.is_ascii_hexdigit()) => {
+            Ok(identifier.to_ascii_lowercase())
+        }
+        Some(_) => Err("Device ID must contain exactly 40 hexadecimal characters"),
+        None => Ok(HEXLOWER.encode(&Sha1::digest(name.as_bytes()))),
+    }
+}
+
+#[cfg(test)]
+mod device_identity_tests {
+    use super::device_id;
+
+    #[test]
+    fn legacy_identity_is_preserved_without_an_override() {
+        assert_eq!(device_id("SyrenSystem", None).unwrap(),
+            super::HEXLOWER.encode(&super::Sha1::digest(b"SyrenSystem")));
+    }
+
+    #[test]
+    fn personal_destinations_can_share_a_name() {
+        let first_id = "1111111111111111111111111111111111111111";
+        let second_id = "2222222222222222222222222222222222222222";
+        assert_ne!(device_id("SyrenSystem", Some(first_id)).unwrap(),
+            device_id("SyrenSystem", Some(second_id)).unwrap());
+    }
+
+    #[test]
+    fn renaming_a_destination_preserves_its_identity() {
+        let identifier = "abcdef0123456789abcdef0123456789abcdef01";
+        assert_eq!(device_id("Kitchen", Some(identifier)).unwrap(),
+            device_id("Living room", Some(identifier)).unwrap());
+        assert_eq!(device_id("Kitchen", Some(&identifier.to_uppercase())).unwrap(), identifier);
+    }
+
+    #[test]
+    fn malformed_device_ids_are_rejected() {
+        for identifier in ["", "abc", "gggggggggggggggggggggggggggggggggggggggg",
+            "11111111111111111111111111111111111111111"] {
+            assert!(device_id("SyrenSystem", Some(identifier)).is_err());
+        }
+    }
+
+    use sha1::Digest;
 }
 
