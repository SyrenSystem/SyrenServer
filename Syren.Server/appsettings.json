{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Syren.Server": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Mqtt": {
    "Host": "localhost",
    "Port": 1883,
    "ClientId": "SyrenServer",
    "Username": null,
    "Password": null,
    "UseTls": false,
    "AutoReconnect": true,
    "ReconnectDelaySeconds": 5,

    "UpdateDistanceTopic": "SyrenSystem/SyrenApp/UpdateDistance",
    "SetSpeakerVolumeTopic": "SyrenSystem/SyrenApp/SetSpeakerVolume",
    "ConnectSpeakerTopic": "SyrenSystem/SyrenApp/ConnectSpeaker",
    "DisconnectSpeakerTopic": "SyrenSystem/SyrenApp/DisconnectSpeaker",

    "GetSpeakerPositionTopic": "SyrenSystem/SyrenServer/GetSpeakerPosition",
    "GetUserPositionTopic": "SyrenSystem/SyrenServer/GetUserPosition",
    "ServerStatusTopic": "SyrenSystem/SyrenServer/Status",
    "ConfigurationTopic": "SyrenSystem/SyrenServer/Configuration",
    "RuntimeTopic": "SyrenSystem/SyrenServer/Runtime",
    "CommandResultTopic": "SyrenSystem/SyrenServer/CommandResult",
    "ConfigureSpeakerTopic": "SyrenSystem/SyrenApp/ConfigureSpeaker",
    "DeleteSpeakerTopic": "SyrenSystem/SyrenApp/DeleteSpeaker",
    "UpsertGroupTopic": "SyrenSystem/SyrenApp/UpsertGroup",
    "DeleteGroupTopic": "SyrenSystem/SyrenApp/DeleteGroup",
    "SetSpeakerLevelTopic": "SyrenSystem/SyrenApp/SetSpeakerLevel"
  },
  "SnapCast": {
    "ServerHost": "localhost",
    "HttpPort": 1780,
    "RequestTimeoutSeconds": 3
  },
  "Playback": {
    "Sources": [
      { "Id": "spotify", "Name": "Spotify" },
      { "Id": "laptop", "Name": "Laptop audio" }
    ],
    "StreamPrefix": "syren-priority",
    "SampleFormat": "48000:16:2",
    "Codec": "pcm",
    "ReconcileSeconds": 5
  },
  "State": {
    "FilePath": "/var/lib/syren-server/state.json"
  },
  "SpeakersOptions": {
    "SpeakersInfo": [
      {
        "SensorId": "44:9F:DA:24:54:C1",
        "SnapClientId": "syren-player-1",
        "FullVolumeDistance": 1000,
        "MuteDistance": 5000
      }
    ]
  }
}
