[Unit]
Description=SyrenSystem Avahi relay for the audio container
After=dbus.service systemd-tmpfiles-setup.service

[Service]
EnvironmentFile=/etc/syrensystem/avahi-relay.env
ExecStart=/usr/bin/python3 -I /usr/local/libexec/syrensystem/syren-avahi-relay.py --listen /run/syren-avahi-relay/system_bus_socket --upstream /run/dbus/system_bus_socket --allow-uid ${SYREN_RELAY_ALLOW_UID}
User=syren-avahi-relay
Group=syren-avahi-relay
ReadWritePaths=/run/syren-avahi-relay
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# Path based unix sockets still work without a network namespace of the host.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
RestrictRealtime=yes
RestrictNamespaces=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
