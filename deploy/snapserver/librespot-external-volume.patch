+// With an external volume the slider stays Spotify state only, and the samples are never scaled.
+fn player_volume(mixer: &dyn Mixer, external_volume: bool) -> Box<dyn VolumeGetter + Send> {
+    if external_volume {
+        Box::new(NoOpVolume)
+    } else {
+        mixer.get_soft_volume()
+    }
+}
+
+#[cfg(test)]
+mod external_volume_tests {
+    use super::{Mixer, MixerConfig, VolumeCtrl, player_volume};
+    use librespot::playback::mixer::softmixer::SoftMixer;
+
+    fn mixer(volume: u16) -> SoftMixer {
+        let mixer = SoftMixer::open(MixerConfig { volume_ctrl: VolumeCtrl::Linear, ..MixerConfig::default() }).unwrap();
+        mixer.set_volume(volume);
+        mixer
+    }
+
+    #[test]
+    fn soft_volume_scales_samples_by_default() {
+        assert_eq!(player_volume(&mixer(0), false).attenuation_factor(), 0.0);
+        assert!(player_volume(&mixer(32768), false).attenuation_factor() < 1.0);
+    }
+
+    #[test]
+    fn external_volume_keeps_the_slider_without_scaling_samples() {
+        let silent = mixer(0);
+        assert_eq!(player_volume(&silent, true).attenuation_factor(), 1.0);
+        assert_eq!(silent.volume(), 0);
+        let half = mixer(32768);
+        assert_eq!(player_volume(&half, true).attenuation_factor(), 1.0);
+        half.set_volume(65535);
+        assert_eq!(half.volume(), 65535);
+    }
+}
